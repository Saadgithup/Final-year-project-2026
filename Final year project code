    <style>
        :root {
            --primary: #89E900; /* Kiwi */
            --primary-light: #A7FF1A;
            --primary-dark: #6BB300;
            --secondary: #A7FF1A; /* Kiwi Light */
            --accent: #6BB300; /* Kiwi Dark */
            --bg-color: #222222; /* Night */
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;

            --bs-body-font-family: 'Inter', sans-serif;
            --bs-body-bg: var(--bg-color);
            --bs-body-color: var(--text-main);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-color);
            background-image:
                radial-gradient(at 0% 0%, rgba(137, 233, 0, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(137, 233, 0, 0.05) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(137, 233, 0, 0.08) 0px, transparent 50%);
            background-attachment: fixed;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* Ambient Shapes */
        .ambient-shape {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            z-index: -1;
            animation: float 20s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
        }

        .shape-1 {
            width: 50vw;
            height: 50vw;
            background: rgba(137, 233, 0, 0.1);
            top: -25vw;
            left: -25vw;
        }

        .shape-2 {
            width: 60vw;
            height: 60vw;
            background: rgba(137, 233, 0, 0.05);
            bottom: -30vw;
            right: -20vw;
            animation-delay: -5s;
        }

        .shape-3 {
            width: 40vw;
            height: 40vw;
            background: rgba(137, 233, 0, 0.08);
            top: 30vh;
            left: 40vw;
            animation-delay: -10s;
        }

        @keyframes float {
            0% {
                transform: translate(0, 0) scale(1) rotate(0deg);
            }

            50% {
                transform: translate(5%, 5%) scale(1.1) rotate(5deg);
            }

            100% {
                transform: translate(-5%, 10%) scale(0.9) rotate(-5deg);
            }
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .navbar-brand,
        .display-1,
        .display-2,
        .display-3,
        .display-4,
        .display-5,
        .display-6 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
        }

        /* Glassmorphism Classes */
        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 1.5rem;
            box-shadow: var(--glass-shadow);
        }

        /* Navbar Customization */
        .navbar {
            background: rgba(34, 34, 34, 0.8) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-size: 1.8rem;
            background: linear-gradient(135deg, #fff, var(--primary));
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1px;
        }

        .nav-link {
            color: var(--text-muted) !important;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
            margin: 0 0.25rem;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #fff !important;
            transform: translateY(-2px);
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 50%;
            background: var(--primary-light);
            transition: all 0.3s ease;
            transform: translateX(-50%);
            border-radius: 2px;
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 80%;
        }

        /* Bootstrap Card Override */
        .card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 1.2rem;
            color: var(--text-main);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
            border-color: rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.06);
        }

        .card-header,
        .card-footer {
            background: rgba(255, 255, 255, 0.02);
            border-color: var(--glass-border);
        }

        /* Buttons Enhancement */
        .btn {
            border-radius: 0.8rem;
            padding: 0.6rem 1.5rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(4px);
            font-family: 'Outfit', sans-serif;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            border: none;
            color: #222222; /* Darker text for readability on kiwi */
            box-shadow: 0 4px 15px rgba(137, 233, 0, 0.3);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--primary-light), var(--primary-dark));
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(137, 233, 0, 0.5);
            color: #222222;
        }

        .btn-outline-primary {
            border: 2px solid var(--primary-light);
            color: var(--primary-light);
            background: transparent;
        }

        .btn-outline-primary:hover {
            background: var(--primary-light);
            color: #222222;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(137, 233, 0, 0.3);
        }

        .btn-light {
            background: rgba(255, 255, 255, 0.9);
            color: var(--bg-color);
            box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2);
        }

        .btn-light:hover {
            background: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.4);
            color: var(--bg-color);
        }

        /* Form Inputs */
        .form-control,
        .form-select {
            background: rgba(34, 34, 34, 0.6);
            border: 1px solid rgba(137, 233, 0, 0.1);
            color: white;
            border-radius: 0.8rem;
            padding: 0.8rem 1.2rem;
            transition: all 0.3s ease;
        }

        .form-control:focus,
        .form-select:focus {
            background: rgba(34, 34, 34, 0.8);
            border-color: var(--primary-light);
            box-shadow: 0 0 0 4px rgba(137, 233, 0, 0.1);
            color: white;
        }

        .form-control::placeholder {
            color: var(--text-muted) !important;
            opacity: 0.7;
        }

        .input-group-text {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-muted);
        }

        select option {
            background: var(--bg-color);
            color: white;
        }

        .text-muted {
            color: var(--text-muted) !important;
        }

        .text-dark {
            color: var(--text-main) !important;
        }

        /* Tables & Lists */
        .table {
            color: var(--text-main);
            border-color: var(--glass-border);
        }

        .table tbody tr {
            transition: all 0.2s ease;
        }

        .table-striped>tbody>tr:nth-of-type(odd)>* {
            color: var(--text-main);
            background-color: rgba(255, 255, 255, 0.02);
            border-color: var(--glass-border);
        }

        .table>tbody>tr:hover>* {
            color: white;
            background-color: rgba(255, 255, 255, 0.05);
        }

        .table th {
            background-color: rgba(255, 255, 255, 0.05);
            border-bottom: 2px solid var(--glass-border);
            color: #fff;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .table td {
            border-bottom: 1px solid var(--glass-border);
            vertical-align: middle;
        }

        .list-group-item {
            background: var(--glass-bg);
            border-color: var(--glass-border);
            color: var(--text-main);
        }

        /* Utilities */
        .text-primary { color: var(--primary) !important; }
        .text-primary-light { color: var(--primary-light) !important; }
        .bg-primary { background-color: var(--primary) !important; }
        .bg-primary-light { background-color: var(--primary-light) !important; }
        .border-primary { border-color: var(--primary) !important; }

        /* Flash Messages Customization */
        .alert {
            backdrop-filter: blur(10px);
            border: 1px solid;
            border-radius: 1rem;
            color: white;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .alert-success {
            background: rgba(137, 233, 0, 0.15);
            border-color: rgba(137, 233, 0, 0.3);
            color: var(--primary-light);
        }

        .alert-danger {
            background: rgba(244, 63, 94, 0.15);
            border-color: rgba(244, 63, 94, 0.3);
            color: #fca5a5;
        }

        .alert-info {
            background: rgba(56, 189, 248, 0.15);
            border-color: rgba(56, 189, 248, 0.3);
            color: #7dd3fc;
        }

        .btn-close {
            filter: invert(1);
            opacity: 0.8;
        }

        /* Hero Area Baseline Reset */
        .hero {
            background: transparent !important;
            padding: 4rem 0 !important;
            position: relative;
            z-index: 2;
        }

        /* Footer */
        footer {
            background: rgba(34, 34, 34, 0.5) !important;
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--glass-border);
            padding: 2rem 0;
            margin-top: auto;
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-color);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        main {
            flex: 1;
            position: relative;
            z-index: 10;
            padding: 2rem 0;
        }

        .badge {
            font-family: 'Outfit', sans-serif;
            font-weight: 500;
            padding: 0.5em 0.8em;
            border-radius: 0.5rem;
        }
    </style>
    
</head>

